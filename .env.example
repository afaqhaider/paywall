# ---------------------------------------------------------------------------
# SS Zentronics Platform - root environment template
# Copy to .env and adjust values. This file is consumed by docker-compose.yml.
# Everything runs locally - no cloud services required.
# ---------------------------------------------------------------------------

# --- General ---
NODE_ENV=development
PLATFORM_VERSION=0.1.0

# --- PostgreSQL ---
POSTGRES_USER=paywall
POSTGRES_PASSWORD=paywall_dev_password
POSTGRES_DB=paywall
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=4000
DATABASE_URL=postgresql://paywall:paywall_dev_password@postgres:5432/paywall?schema=public

# Comma-separated allowlist of origins permitted to call the API.
# Leave empty to allow all origins (local development only - do NOT leave empty in production).
CORS_ORIGIN=http://localhost:3000

# Structured logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (requests per window, per client)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
