# ---------------------------------------------------------------------------
# SS Zentronics Platform - root environment template
# Copy to .env and adjust values. This file is consumed by docker-compose.yml.
# Everything runs locally - no cloud services required.
# ---------------------------------------------------------------------------

# --- General ---
NODE_ENV=development
PLATFORM_VERSION=0.1.0

# --- PostgreSQL ---
POSTGRES_USER=paywall
POSTGRES_PASSWORD=paywall_dev_password
POSTGRES_DB=paywall
POSTGRES_PORT=5432

# --- API (NestJS) ---
API_PORT=4000
DATABASE_URL=postgresql://paywall:paywall_dev_password@postgres:5432/paywall?schema=public

# Signs JWT access tokens - must be at least 32 characters. Generate with:
#   openssl rand -base64 48
# There is no default: the app refuses to boot without a real secret.
JWT_ACCESS_SECRET=

# Encrypts Application Registry secrets (API keys, webhook secrets, OAuth
# credentials, ...) at rest, AES-256-GCM. Must be a base64-encoded 32-byte
# key. Generate with:
#   openssl rand -base64 32
# There is no default: the app refuses to boot without a real key.
APP_SECRET_ENCRYPTION_KEY=

# Comma-separated allowlist of origins permitted to call the API (also used
# for CSRF/cookie same-site checks). Leave empty to allow all origins
# (local development only - do NOT leave empty in production).
WEB_ORIGIN=http://localhost:3000

# Structured logging level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Rate limiting (requests per window, per client)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Google Sign-In (OAuth 2.0 Web client from Google Cloud Console).
# Leave all three empty to disable - /auth/google returns 501 instead of
# crashing the app. GOOGLE_CALLBACK_URL must exactly match a redirect URI
# registered on that OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PLATFORM_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Firebase (provisioning stub - not required to run this project)
#
# No Firebase project exists for this deployment yet. Leave every value
# below empty until one is created; the app boots and runs fine without
# them (see apps/api/src/config/secrets.ts and apps/web/src/lib/env.ts -
# `firebase.configured` is false and nothing depends on that being true).
#
# When you do provision a Firebase project (for this business or when
# replicating this project for a new one), fill these in and nothing else
# needs to change:
#   - FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY:
#     Admin SDK service account credentials (server-side, apps/api only).
#     Download from Firebase Console > Project Settings > Service Accounts
#     > Generate new private key.
#   - FIREBASE_SECRET_MANAGER_PROJECT_ID: GCP project id that hosts Secret
#     Manager, if different from FIREBASE_PROJECT_ID.
#   - NEXT_PUBLIC_FIREBASE_*: the client-side Firebase SDK config object
#     from Firebase Console > Project Settings > General > Your apps > SDK
#     setup and configuration. These are not secret (they're safe to ship
#     to the browser) but still route through apps/web/src/lib/env.ts so
#     there's one place to update.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SECRET_MANAGER_PROJECT_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
