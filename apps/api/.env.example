NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://paywall:paywall_dev_password@localhost:5432/paywall?schema=public
PLATFORM_VERSION=0.1.0

# Signs JWT access tokens - must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# Encrypts Application Registry secrets at rest, AES-256-GCM. Must be a
# base64-encoded 32-byte key. Generate with:
#   openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100

# Google Sign-In (OAuth 2.0 Web client from Google Cloud Console).
# Leave all three empty to disable - /auth/google returns 501 instead of
# crashing the app. GOOGLE_CALLBACK_URL must exactly match a redirect URI
# registered on that OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Firebase (provisioning stub - not required to run this project). Leave
# empty until a Firebase project exists for this deployment; see
# apps/api/src/config/secrets.ts and docs/SECRETS.md.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SECRET_MANAGER_PROJECT_ID=
