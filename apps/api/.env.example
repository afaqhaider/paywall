NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://paywall:paywall_dev_password@localhost:5432/paywall?schema=public
PLATFORM_VERSION=0.1.0

# Signs JWT access tokens - must be at least 32 characters. Generate with:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# Encrypts Application Registry secrets at rest, AES-256-GCM. Must be a
# base64-encoded 32-byte key. Generate with:
#   openssl rand -base64 32
APP_SECRET_ENCRYPTION_KEY=

WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=100
