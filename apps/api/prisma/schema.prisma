// Phase 4: Subscription Engine (provider-independent core).
// Phase 5: Payment Provider Framework (adapters for Stripe/Apple/Google/
// PayPal/Easypaisa/JazzCash/bank transfer/manual).
// Runtime entitlement enforcement, license keys, accounting/tax: not yet.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

