model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members             OrganizationMember[]
  auditLogs           AuditLog[]
  applications        Application[]
  products            Product[]
  customers           Customer[]
  subscriptions       Subscription[]
  coupons             Coupon[]
  paymentProviders    PaymentProvider[]
  entitlementGrants   EntitlementGrant[]
  featureAccess       FeatureAccess[]
  licenses            License[]
  apiClients          APIClient[]
  deviceRegistrations DeviceRegistration[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model AuditLog {
  id             String        @id @default(uuid())
  action         AuditAction
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  applicationId  String?
  application    Application?  @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([applicationId])
  @@map("audit_logs")
}

/// The single source of truth for every application in the SS Zentronics
/// ecosystem (e.g. LedGix ERP, LedGix Expense, Taskue, HydroMetrix, Tower
/// Dominion). Owned by exactly one Organization; per-application access is
/// governed by ApplicationMember, with an OWNER/ADMINISTRATOR of the owning
/// organization always retaining override access (see ApplicationRoleGuard).
model Application {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name             String
  slug             String                @unique
  displayName      String?
  description      String?
  category         String?
  bundleIdentifier String?               @unique
  packageName      String?               @unique
  webIdentifier    String?               @unique
  logoUrl          String?
  iconUrl          String?
  primaryColor     String?
  status           ApplicationStatus     @default(ACTIVE)
  visibility       ApplicationVisibility @default(PRIVATE)

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  versions               ApplicationVersion[]
  environments           ApplicationEnvironment[]
  secrets                ApplicationSecret[]
  domains                ApplicationDomain[]
  settings               ApplicationSetting[]
  members                ApplicationMember[]
  auditLogs              AuditLog[]
  products               Product[]
  features               Feature[]
  entitlementDefinitions EntitlementDefinition[]
  customers              Customer[]
  subscriptions          Subscription[]
  entitlementGrants      EntitlementGrant[]
  licenses               License[]
  featureAccess          FeatureAccess[]
  usageLimits            UsageLimit[]
  usageCounters          UsageCounter[]
  apiClients             APIClient[]
  deviceRegistrations    DeviceRegistration[]

  @@index([organizationId])
  @@map("applications")
}

/// One row per release on a track (e.g. "stable", "beta") - all platforms
/// ship together in a single release event. `isLatest` marks the current
/// release for that track; older rows are release history.
model ApplicationVersion {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  track                   String    @default("stable")
  androidVersion          String?
  iosVersion              String?
  webVersion              String?
  buildNumber             String?
  minimumSupportedVersion String?
  releaseNotes            String?
  releaseDate             DateTime?
  isLatest                Boolean   @default(false)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([applicationId])
  @@index([applicationId, track])
  @@map("application_versions")
}

/// One row per (application, environment type). Holds environment-specific
/// URLs plus free-form JSON for environment variables and feature flags.
model ApplicationEnvironment {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type         ApplicationEnvironmentType
  baseUrl      String?
  apiUrl       String?
  variables    Json?
  featureFlags Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  secrets ApplicationSecret[]

  @@unique([applicationId, type])
  @@map("application_environments")
}

/// Encrypted (AES-256-GCM) storage for API keys, webhook secrets, JWT
/// secrets, OAuth credentials, and future payment credentials. The
/// plaintext value is never persisted and never returned by any API -
/// only `lastFour` (a display hint) and metadata are exposed.
model ApplicationSecret {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  environmentId String?
  environment   ApplicationEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  type           ApplicationSecretType
  key            String
  encryptedValue String
  iv             String
  authTag        String
  lastFour       String?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  rotatedAt   DateTime?

  @@unique([applicationId, environmentId, key])
  @@index([applicationId])
  @@map("application_secrets")
}

/// Custom domains an application is reachable on. Exactly one domain per
/// application may have `isPrimary = true` (enforced in service logic, the
/// same way OrganizationsService enforces last-owner protection).
model ApplicationDomain {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  domain             String                   @unique
  isPrimary          Boolean                  @default(false)
  sslStatus          DomainSslStatus          @default(PENDING)
  verificationStatus DomainVerificationStatus @default(PENDING)
  verificationToken  String?
  verifiedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationId])
  @@map("application_domains")
}

/// Application-level key/value settings (maintenance mode, public
/// registration, allow invitations, support email, theme, branding, ...).
model ApplicationSetting {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  key   String
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, key])
  @@map("application_settings")
}

model ApplicationMember {
  id            String                @id @default(uuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          ApplicationMemberRole @default(VIEWER)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([applicationId, userId])
  @@index([userId])
  @@map("application_members")
}

// =====================================================================
// Subscription Engine (Phase 4) - provider-independent core.
// No payment collection, invoicing, or webhook ingestion happens here;
// this layer only models the commercial catalog and subscription
// lifecycle so any provider (web, App Store, Play, Easypaisa, JazzCash,
// bank transfer, manual) can plug in later without changing this schema.
// =====================================================================

/// A commercial offering linked to an Application (e.g. "LedGix Expense",
/// "HydroMetrix Premium"). One Application can have multiple Products.
model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  name        String
  slug        String            @unique
  description String?
  status      ProductStatus     @default(DRAFT)
  visibility  ProductVisibility @default(PRIVATE)
  metadata    Json?

  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  plans            Plan[]
  subscriptions    Subscription[]
  trials           Trial[]
  coupons          Coupon[]
  checkoutSessions PaymentCheckoutSession[]

  @@index([organizationId])
  @@index([applicationId])
  @@map("products")
}

/// A pricing/feature tier of a Product (Free, Basic, Pro, Enterprise, ...).
model Plan {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name          String
  code          String
  description   String?
  billingType   PlanBillingType @default(RECURRING)
  trialEligible Boolean         @default(false)
  trialDays     Int?
  seatLimit     Int?
  status        PlanStatus      @default(DRAFT)
  sortOrder     Int             @default(0)
  metadata      Json?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  prices           Price[]
  planFeatures     PlanFeature[]
  subscriptions    Subscription[]
  trials           Trial[]
  coupons          Coupon[]
  targetOfChanges  SubscriptionChange[]
  checkoutSessions PaymentCheckoutSession[]

  @@unique([productId, code])
  @@index([productId])
  @@map("plans")
}

/// A price point for a Plan. Amounts are always integer minor units
/// (cents) - never floating point. Multiple Prices let a Plan support
/// several currencies/regions/intervals simultaneously.
model Price {
  id     String @id @default(uuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  currency      String // ISO 4217, e.g. "USD", "PKR"
  amountMinor   Int // integer minor units - never a float
  interval      BillingInterval @default(MONTH)
  intervalCount Int             @default(1)
  taxInclusive  Boolean         @default(false)
  countryCode   String? // ISO 3166-1 alpha-2; null = default/global
  providerRef   String? // external provider's own price ID, purely a reference
  effectiveAt   DateTime        @default(now())
  expiresAt     DateTime?
  status        PriceStatus     @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionItems SubscriptionItem[]
  targetOfChanges   SubscriptionChange[]
  checkoutSessions  PaymentCheckoutSession[]

  @@index([planId])
  @@map("prices")
}

/// A capability an Application exposes to plans (number of users, storage,
/// API access, ...). Shared across every Product of that Application.
model Feature {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  key         String
  name        String
  description String?
  type        FeatureType @default(BOOLEAN)
  unit        String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  planFeatures           PlanFeature[]
  usageRecords           UsageRecord[]
  entitlementDefinitions EntitlementDefinition[]

  @@unique([applicationId, key])
  @@map("features")
}

/// The value of one Feature on one Plan (a boolean flag, a numeric limit,
/// free text, or "unlimited").
model PlanFeature {
  id        String  @id @default(uuid())
  planId    String
  plan      Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  boolValue   Boolean?
  numberValue Int?
  textValue   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, featureId])
  @@map("plan_features")
}

/// A stable, application-scoped key that client SDKs will check at runtime
/// once Phase 6 implements entitlement enforcement. Decouples the runtime
/// check key from how a Feature happens to be billed/labeled.
model EntitlementDefinition {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  featureId     String?
  feature       Feature?    @relation(fields: [featureId], references: [id], onDelete: SetNull)

  key         String
  name        String
  description String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  entitlementGrants EntitlementGrant[]
  featureAccess     FeatureAccess[]
  usageLimits       UsageLimit[]
  usageCounters     UsageCounter[]

  @@unique([applicationId, key])
  @@map("entitlement_definitions")
}

/// A platform-level customer identity, distinct from the auth User model.
/// May represent an individual, an organization/company, or a purely
/// external identity - and carries a free-form map of external provider
/// customer IDs (`{"stripe": "cus_123", ...}`) without coupling this
/// engine to any specific provider's schema.
model Customer {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  type        CustomerType @default(INDIVIDUAL)
  displayName String?
  email       String?
  externalIds Json?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions       Subscription[]
  usageRecords        UsageRecord[]
  trials              Trial[]
  subscriptionCoupons SubscriptionCoupon[]
  promotionCodes      PromotionCode[]
  paymentCustomers    PaymentCustomer[]
  checkoutSessions    PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  paymentInvoices     PaymentInvoice[]

  @@index([organizationId])
  @@index([applicationId])
  @@index([userId])
  @@map("customers")
}

/// The core subscription record. Provider-agnostic: `provider` +
/// `providerSubscriptionId` are just a reference to wherever the money
/// side eventually lives (Phase 5) - none of the lifecycle logic here
/// depends on any specific provider's API or webhook shape.
model Subscription {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  planId         String
  plan           Plan         @relation(fields: [planId], references: [id])
  applicationId  String
  application    Application  @relation(fields: [applicationId], references: [id])

  environmentType        ApplicationEnvironmentType @default(PRODUCTION)
  provider               SubscriptionProvider       @default(MANUAL)
  providerSubscriptionId String?
  status                 SubscriptionStatus         @default(INCOMPLETE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialStart         DateTime?
  trialEnd           DateTime?

  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  cancellationReason String?
  gracePeriodEnd     DateTime?

  quantity Int   @default(1)
  metadata Json?
  version  Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items               SubscriptionItem[]
  events              SubscriptionEvent[]
  changes             SubscriptionChange[]
  trial               Trial?
  subscriptionCoupons SubscriptionCoupon[]
  usageRecords        UsageRecord[]
  prorationRecords    ProrationRecord[]
  checkoutSessions    PaymentCheckoutSession[]
  paymentTransactions PaymentTransaction[]
  paymentInvoices     PaymentInvoice[]
  entitlementGrants   EntitlementGrant[]
  licenses            License[]
  usageCounters       UsageCounter[]

  @@index([organizationId])
  @@index([customerId])
  @@index([productId])
  @@index([applicationId])
  @@index([status])
  @@map("subscriptions")
}

/// A line item on a subscription (usually one, but supports future
/// multi-item / add-on subscriptions).
model SubscriptionItem {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  priceId        String
  price          Price        @relation(fields: [priceId], references: [id])

  quantity Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@map("subscription_items")
}

/// An immutable, append-only record of every subscription lifecycle
/// transition. Never updated or deleted; `idempotencyKey` lets a caller
/// safely retry the same mutation without double-recording the event.
model SubscriptionEvent {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  idempotencyKey String?               @unique
  metadata       Json?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([subscriptionId])
  @@index([type])
  @@map("subscription_events")
}

/// A scheduled subscription change (downgrade at renewal, cancel at period
/// end, interval switch, seat reduction, ...) applied at the correct
/// lifecycle event rather than immediately.
model SubscriptionChange {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  type           SubscriptionChangeType
  status         SubscriptionChangeStatus @default(PENDING)
  targetPlanId   String?
  targetPlan     Plan?                    @relation(fields: [targetPlanId], references: [id])
  targetPriceId  String?
  targetPrice    Price?                   @relation(fields: [targetPriceId], references: [id])
  targetQuantity Int?
  effectiveAt    DateTime
  appliedAt      DateTime?
  canceledAt     DateTime?
  metadata       Json?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
  @@map("subscription_changes")
}

/// A calculated (not collected) proration adjustment for an immediate
/// plan/seat/interval change - credit for unused time on the old price,
/// charge for remaining time on the new one. Money never moves here;
/// Phase 5 will read these records when it actually collects payment.
model ProrationRecord {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  reason      ProrationReason
  creditMinor Int             @default(0)
  chargeMinor Int             @default(0)
  netMinor    Int
  currency    String
  periodStart DateTime
  periodEnd   DateTime
  changeAt    DateTime        @default(now())
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@map("proration_records")
}

/// One trial per (customer, product) - enforced by the unique constraint,
/// the simplest reliable abuse-prevention mechanism; `deviceFingerprint`/
/// `ipAddress` are recorded for future, stronger abuse detection.
model Trial {
  id             String        @id @default(uuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  planId         String
  plan           Plan          @relation(fields: [planId], references: [id])
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  startedAt DateTime    @default(now())
  endsAt    DateTime
  status    TrialStatus @default(ACTIVE)

  convertedAt DateTime?
  canceledAt  DateTime?

  deviceFingerprint String?
  ipAddress         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([productId])
  @@map("trials")
}

/// An internal discount definition. `PromotionCode` is the customer-facing
/// redeemable code layered on top - one Coupon can back many codes.
model Coupon {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code             String
  name             String?
  discountType     CouponDiscountType
  amountOffMinor   Int?
  percentOff       Int?
  currency         String?
  duration         CouponDuration     @default(ONCE)
  durationInCycles Int?
  maxRedemptions   Int?
  redemptionCount  Int                @default(0)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  planId    String?
  plan      Plan?    @relation(fields: [planId], references: [id], onDelete: Cascade)

  expiresAt DateTime?
  status    CouponStatus @default(ACTIVE)
  metadata  Json?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  promotionCodes      PromotionCode[]
  subscriptionCoupons SubscriptionCoupon[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("coupons")
}

/// A customer-facing redeemable code backed by a Coupon. Optionally
/// restricted to one specific Customer.
model PromotionCode {
  id       String @id @default(uuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  code            String  @unique
  active          Boolean @default(true)
  maxRedemptions  Int?
  redemptionCount Int     @default(0)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptionCoupons SubscriptionCoupon[]

  @@index([couponId])
  @@map("promotion_codes")
}

/// A coupon applied to one specific subscription.
model SubscriptionCoupon {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  couponId       String
  coupon         Coupon       @relation(fields: [couponId], references: [id])

  promotionCodeId String?
  promotionCode   PromotionCode? @relation(fields: [promotionCodeId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])

  appliedAt DateTime  @default(now())
  endsAt    DateTime?
  removedAt DateTime?

  createdAt DateTime @default(now())

  @@index([subscriptionId])
  @@map("subscription_coupons")
}

/// A single usage event for a metered Feature. `idempotencyKey` prevents
/// double-counting on retry. No usage-based invoicing happens here -
/// this is purely a recording foundation for Phase 5+.
model UsageRecord {
  id             String        @id @default(uuid())
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  featureId      String
  feature        Feature       @relation(fields: [featureId], references: [id])

  quantity       Int
  occurredAt     DateTime @default(now())
  idempotencyKey String   @unique
  source         String?
  metadata       Json?

  createdAt DateTime @default(now())

  @@index([customerId])
  @@index([subscriptionId])
  @@index([featureId])
  @@map("usage_records")
}

// =====================================================================
// Entitlement & License Engine (Phase 6) - the runtime authorization
// layer. Consumes Subscription Engine state (Phase 4) and the
// Feature/EntitlementDefinition catalog; grants nothing to and reads
// nothing from the Payment Provider Framework (Phase 5, built in
// parallel - deliberately not referenced anywhere in this schema).
//
// The spec's "Entitlement" catalog model is fulfilled by the existing
// EntitlementDefinition (Phase 4) rather than a duplicate model - its
// docstring already describes it as exactly that: "the stable,
// application-scoped key that client SDKs will check at runtime once
// Phase 6 implements entitlement enforcement."
// =====================================================================

/// A materialized grant of one EntitlementDefinition to an
/// organization/application pair, resolved from an active Subscription (or
/// created manually/promotionally/via trial). FeatureAccess is the fast-path
/// read cache computed from the currently-active grant; this table is the
/// source of truth and full history (superseded rows are revoked, never
/// deleted or mutated in place).
model EntitlementGrant {
  id                      String                @id @default(uuid())
  entitlementDefinitionId String
  entitlementDefinition   EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)
  organizationId          String
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId           String
  application             Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subscriptionId          String?
  subscription            Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  source EntitlementGrantSource
  status EntitlementGrantStatus @default(ACTIVE)

  boolValue   Boolean?
  numberValue Int?
  textValue   String?
  isUnlimited Boolean  @default(false)

  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  revokedAt     DateTime?
  revokedReason String?

  idempotencyKey String? @unique
  metadata       Json?
  version        Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events EntitlementGrantEvent[]

  @@index([organizationId, applicationId])
  @@index([entitlementDefinitionId])
  @@index([subscriptionId])
  @@index([status])
  @@map("entitlement_grants")
}

/// Immutable, append-only log of every EntitlementGrant lifecycle
/// transition (created, revoked, expired, superseded) - the same pattern
/// SubscriptionEvent uses for the same reason: an auditable, never-mutated
/// history independent of the grant's current-state row.
model EntitlementGrantEvent {
  id      String           @id @default(uuid())
  grantId String
  grant   EntitlementGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  type     String
  metadata Json?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([grantId])
  @@map("entitlement_grant_events")
}

/// Denormalized, single-row-per-key fast-path read cache: exactly what
/// `hasEntitlement()` reads at request time (one indexed lookup, no joins
/// through Subscription -> Plan -> PlanFeature -> EntitlementGrant). Rebuilt
/// whenever the underlying EntitlementGrant changes; `sourceGrantId` points
/// back to the grant it was computed from for traceability.
model FeatureAccess {
  id                      String                @id @default(uuid())
  organizationId          String
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId           String
  application             Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  entitlementDefinitionId String
  entitlementDefinition   EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)

  hasAccess   Boolean
  numberValue Int?
  textValue   String?
  isUnlimited Boolean @default(false)

  sourceGrantId String?
  computedAt    DateTime @default(now())

  @@unique([organizationId, applicationId, entitlementDefinitionId])
  @@index([applicationId])
  @@map("feature_access")
}

/// A license grant - individual, seat-based, device-based, lifetime,
/// trial, enterprise, temporary, or manually issued. `subscriptionId` is
/// set when the license is derived from a Subscription Engine subscription;
/// standalone licenses (e.g. a manually-issued lifetime license) leave it null.
model License {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  type   LicenseType
  status LicenseStatus @default(ACTIVE)

  seatLimit   Int?
  deviceLimit Int?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  metadata  Json?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments         LicenseAssignment[]
  seats               Seat[]
  licenseKeys         LicenseKey[]
  deviceRegistrations DeviceRegistration[]

  @@index([organizationId])
  @@index([applicationId])
  @@index([subscriptionId])
  @@index([status])
  @@map("licenses")
}

/// Assigns an INDIVIDUAL-type License directly to a User (no seat
/// indirection needed for single-user licenses).
model LicenseAssignment {
  id        String  @id @default(uuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  @@unique([licenseId, userId])
  @@index([userId])
  @@map("license_assignments")
}

/// One purchased seat slot under a SEAT-type License. `Seat` is the slot
/// itself; `SeatAssignment` is the append-only history of who has occupied
/// it - a transfer creates a new SeatAssignment rather than mutating the
/// old one, so seat history is always reconstructable.
model Seat {
  id        String  @id @default(uuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  status SeatStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments SeatAssignment[]

  @@index([licenseId])
  @@index([status])
  @@map("seats")
}

model SeatAssignment {
  id     String @id @default(uuid())
  seatId String
  seat   Seat   @relation(fields: [seatId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SeatAssignmentStatus @default(PENDING)

  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?

  createdAt DateTime @default(now())

  @@index([seatId])
  @@index([userId])
  @@map("seat_assignments")
}

/// The current, resolved ceiling for a (organization, application,
/// entitlement) quota - denormalized from the active EntitlementGrant's
/// `numberValue` for fast lookup, same rationale as FeatureAccess.
model UsageLimit {
  id                      String                @id @default(uuid())
  organizationId          String
  applicationId           String
  application             Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  entitlementDefinitionId String
  entitlementDefinition   EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)

  limitValue  Int?
  isUnlimited Boolean          @default(false)
  resetPolicy UsageResetPolicy @default(NEVER)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([organizationId, applicationId, entitlementDefinitionId])
  @@map("usage_limits")
}

/// The running counter enforced against UsageLimit. Distinct from Phase
/// 4's `UsageRecord` (an append-only per-event billing/metering log): this
/// is a single mutable row per (scope, entitlement) optimized for
/// increment/decrement checks on every request, not an audit trail.
model UsageCounter {
  id                      String                @id @default(uuid())
  organizationId          String
  applicationId           String
  application             Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  entitlementDefinitionId String
  entitlementDefinition   EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)
  subscriptionId          String?
  subscription            Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  value       Int       @default(0)
  periodStart DateTime  @default(now())
  periodEnd   DateTime?
  lastResetAt DateTime  @default(now())

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([organizationId, applicationId, entitlementDefinitionId])
  @@index([subscriptionId])
  @@map("usage_counters")
}

/// A named integration/consumer that owns one or more APIKeys. Organization-
/// and optionally application-scoped, per the "API Access" entitlement.
model APIClient {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  name        String
  description String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys APIKey[]

  @@index([organizationId])
  @@index([applicationId])
  @@map("api_clients")
}

/// A generated API credential. Only `keyHash` (SHA-256) is ever persisted -
/// the same one-way-hash pattern already used for refresh/verification/
/// reset tokens in the auth module; the plaintext key is shown exactly
/// once, at creation, and is never recoverable afterward.
model APIKey {
  id          String    @id @default(uuid())
  apiClientId String
  apiClient   APIClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  name            String
  keyPrefix       String
  keyHash         String    @unique
  lastFour        String
  rateLimitPerMin Int?
  expiresAt       DateTime?
  revokedAt       DateTime?
  rotatedAt       DateTime?
  lastUsedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scopes APIKeyScope[]

  @@index([apiClientId])
  @@map("api_keys")
}

model APIKeyScope {
  id       String @id @default(uuid())
  apiKeyId String
  apiKey   APIKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  scope    String

  createdAt DateTime @default(now())

  @@unique([apiKeyId, scope])
  @@map("api_key_scopes")
}

/// A human-readable, offline-activatable license key. Hashed the same way
/// as APIKey (SHA-256, shown once); `displayCode` retains a masked hint
/// (e.g. "SSZP-****-****-9F2A") for support/admin display without ever
/// storing or returning the full plaintext key.
model LicenseKey {
  id        String  @id @default(uuid())
  licenseId String
  license   License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  keyHash         String        @unique
  displayCode     String
  activationLimit Int           @default(1)
  activationCount Int           @default(0)
  status          LicenseStatus @default(ACTIVE)
  expiresAt       DateTime?
  revokedAt       DateTime?
  transferredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([licenseId])
  @@map("license_keys")
}

/// A device that has activated against a License (device-limited licenses)
/// or is simply registered under an application/user for entitlement
/// checks (push notifications, session hygiene, "sign out other devices").
model DeviceRegistration {
  id             String        @id @default(uuid())
  applicationId  String
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  licenseId      String?
  license        License?      @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  deviceId   String
  platform   DevicePlatform
  status     DeviceStatus   @default(ACTIVE)
  appVersion String?
  osVersion  String?
  pushToken  String?
  lastSeenAt DateTime       @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicationId, deviceId])
  @@index([userId])
  @@index([licenseId])
  @@map("device_registrations")
}

/// Security-relevant access events - API key auth attempts, license/device
/// activations, seat assignment changes. Deliberately NOT a row per routine
/// `hasEntitlement()` check (that would defeat the "millions of users,
/// minimize database queries" requirement); structural entitlement changes
/// already go through the shared AuditLog like every other phase. Plain
/// (non-relational) id columns by design - a high-write-volume log
/// shouldn't carry FK constraint overhead on its hot insert path.
model AccessLog {
  id                      String  @id @default(uuid())
  organizationId          String?
  applicationId           String?
  userId                  String?
  apiKeyId                String?
  entitlementDefinitionId String?

  action   String
  allowed  Boolean
  reason   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([applicationId])
  @@index([apiKeyId])
  @@map("access_logs")
}
