# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Env files
.env
.env.local
.env.*.local
!.env.example

# OAuth client secrets downloaded from provider consoles - never commit these
client_secret*.json
google-services*.json

# Local-only secret material (downloaded OAuth secrets, Firebase service
# account keys, etc.) - never commit anything in here. Real values only
# ever belong in .env (also gitignored) or the deploy-time secret manager.
secrets/local/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Testing
coverage/
playwright-report/
test-results/
blob-report/

# Editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Docker
docker/postgres/data/
